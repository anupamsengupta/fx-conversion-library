<?xml version="1.0" encoding="UTF-8"?>
<!--
  fx-api, Phase 1 module (Task 1.1).

  JDK-only, no I/O, no system clock (D-01). jakarta.inject is declared at
  `provided` scope only (A-04/TI-02): fx-api does not require a DI
  container to compile or run, but its types may be annotated for
  consumption by fx-guice in a later phase.

  Test dependencies are plain JUnit 5 only. fx-testkit does not exist yet
  (Phase 3b), so fx-api's own acceptance tests (ValueTypeValidationTest,
  ReconciliationToleranceTest, the partial SealedExhaustivenessTest, and
  the RateFinality.weakest() property check) live here, hand-written,
  with no dependency on a shared test-fixture module.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.power.fx</groupId>
        <artifactId>fx-conversion</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fx-api</artifactId>
    <packaging>jar</packaging>

    <name>fx-api</name>
    <description>
        Public API surface, value types, sealed request/result hierarchies
        and SPI ports for the FX Conversion Library. JDK-only; no
        framework, no I/O, no system clock on the resolution path (D-01).
    </description>

    <dependencies>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>2.0.1</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!--
              Task 1.16 (FxVersion, TI-05 provisional): fx-version.properties
              is filtered so ${project.version} is substituted into the
              packaged resource. This is a provisional mechanism pending
              TI-05's final decision between resource filtering and a
              generated class; see FxVersion's Javadoc.
            -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>
</project>
